{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "Craft or profession category (e.g., سباك، كهربائي، نجار)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "icon": { "type": "string", "maxLength": 50 },
        "sort_order": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "hidden"] }
      },
      "required": ["id", "name", "sort_order", "status"]
    },
    "Area": {
      "title": "Area",
      "description": "Village or district name",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["active", "hidden"] }
      },
      "required": ["id", "name", "status"]
    },
    "ExperienceOption": {
      "title": "ExperienceOption",
      "description": "Years of craft experience options",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "label": { "type": "string", "maxLength": 100 },
        "sort_order": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "hidden"] }
      },
      "required": ["id", "label", "sort_order", "status"]
    },
    "Provider": {
      "title": "Provider",
      "description": "Craftsman or local service provider listing",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 150 },
        "category_id": { "type": "string", "maxLength": 64 },
        "area_id": { "type": "string", "maxLength": 64 },
        "phone": { "type": "string", "maxLength": 20 },
        "secondary_phone": { "type": "string", "maxLength": 20 },
        "whatsapp": { "type": "string", "maxLength": 20 },
        "description": { "type": "string", "maxLength": 1000 },
        "services": { "type": "string", "maxLength": 1000 },
        "price_description": { "type": "string", "maxLength": 500 },
        "working_hours": { "type": "string", "maxLength": 500 },
        "photo_url": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["active", "hidden", "pending"] },
        "is_premium": { "type": "boolean" },
        "premium_expires_at": { "type": "string", "maxLength": 50 },
        "experience_id": { "type": "string", "maxLength": 64 },
        "is_verified": { "type": "boolean" },
        "has_whatsapp": { "type": "boolean" },
        "created_at": { "type": "string", "maxLength": 50 },
        "updated_at": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "category_id", "area_id", "phone", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "User review and rating for a provider",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "provider_id": { "type": "string", "maxLength": 64 },
        "author_name": { "type": "string", "maxLength": 100 },
        "author_phone": { "type": "string", "maxLength": 20 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected"] },
        "created_at": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "provider_id", "author_name", "rating", "comment", "status"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrator",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 255 },
        "is_owner": { "type": "boolean" },
        "active": { "type": "boolean" },
        "created_at": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "email", "active"]
    }
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": "#/entities/Category",
      "description": "Global craft categories"
    },
    "/areas/{areaId}": {
      "schema": "#/entities/Area",
      "description": "Villages and service regions"
    },
    "/experience_options/{experienceId}": {
      "schema": "#/entities/ExperienceOption",
      "description": "Experience duration tiers"
    },
    "/providers/{providerId}": {
      "schema": "#/entities/Provider",
      "description": "Craftsmen and business listings"
    },
    "/reviews/{reviewId}": {
      "schema": "#/entities/Review",
      "description": "User ratings and feedback"
    },
    "/admin_users/{adminId}": {
      "schema": "#/entities/AdminUser",
      "description": "Admin accounts allowlist"
    }
  }
}
